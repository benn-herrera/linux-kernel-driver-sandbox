# Runs inside the build container, mounted read-only at /work/vdev.
# Every path here is a container path.

set positional-arguments

KERNEL_VERSION := "7.2.7"
KERNEL_SRC := "/kernel/linux-" + KERNEL_VERSION
OUT := "/work/out"
# clang/LLVM for every kbuild invocation: the kernel's Rust support builds with LLVM.
MAKE := "make LLVM=1"

[doc("Download, verify and extract the pinned kernel source into the volume (no-op if present)")]
kernel-fetch:
  #!/usr/bin/env bash
  set -euo pipefail
  if [[ -d "{{KERNEL_SRC}}" ]]; then
    printf '%s already present; nothing to fetch\n' "{{KERNEL_SRC}}" >&2
    exit 0
  fi
  cd /kernel
  version="{{KERNEL_VERSION}}"
  tarball="linux-${version}.tar.xz"
  url_dir="https://cdn.kernel.org/pub/linux/kernel/v${version%%.*}.x"
  printf 'downloading %s/%s\n' "${url_dir}" "${tarball}" >&2
  curl -fsSLO "${url_dir}/${tarball}"
  curl -fsSLO "${url_dir}/sha256sums.asc"
  grep -E "  ${tarball}$" sha256sums.asc | sha256sum -c -
  tar -xf "${tarball}"
  rm -f "${tarball}" sha256sums.asc
  printf 'extracted to %s\n' "{{KERNEL_SRC}}" >&2

[doc("Configure the kernel: defconfig, the debug.config fragment, then /work/vdev/kernel-config/*.config merged on top")]
kernel-config: kernel-fetch
  #!/usr/bin/env bash
  set -euo pipefail
  cd "{{KERNEL_SRC}}"
  {{MAKE}} defconfig debug.config
  [[ -f .config ]] || { printf '.config missing after make\n' >&2; exit 1; }
  scripts/kconfig/merge_config.sh -m .config /work/vdev/kernel-config/*.config
  {{MAKE}} olddefconfig
  printf '%s/.config written\n' "{{KERNEL_SRC}}" >&2
  for opt in KASAN PROVE_LOCKING DEBUG_ATOMIC_SLEEP UBSAN RUST; do
    printf 'CONFIG_%s=%s\n' "${opt}" "$(scripts/config --state "${opt}")"
  done
  # Kconfig drops CONFIG_RUST=y silently when RUST_IS_AVAILABLE is false; this is the only reliable signal.
  [[ "$(scripts/config --state RUST)" == "y" ]] || { printf "CONFIG_RUST did not survive: run '%s rustavailable' in %s\n" "{{MAKE}}" "{{KERNEL_SRC}}" >&2; exit 1; }

[doc("Build the kernel Image and in-tree modules, and copy the Image to OUT/Image")]
kernel-build: kernel-config
  #!/usr/bin/env bash
  set -euo pipefail
  cd "{{KERNEL_SRC}}"
  {{MAKE}} -j"$(nproc)" Image modules
  cp arch/arm64/boot/Image "{{OUT}}/Image"
  printf 'built %s/Image\n' "{{OUT}}" >&2

[doc("make clean in the kernel tree (keeps .config); no-op if the tree is absent")]
kernel-clean:
  #!/usr/bin/env bash
  set -euo pipefail
  if [[ ! -d "{{KERNEL_SRC}}" ]]; then
    printf '%s absent; nothing to clean\n' "{{KERNEL_SRC}}" >&2
    exit 0
  fi
  {{MAKE}} -C "{{KERNEL_SRC}}" clean

[doc("Build every out-of-tree module under /work/drivers/*/ with M= against the kernel tree; .ko files go to OUT/modules/")]
modules: kernel-config
  #!/usr/bin/env bash
  set -euo pipefail
  shopt -s nullglob
  [[ -f "{{KERNEL_SRC}}/Module.symvers" ]] || { printf "%s/Module.symvers missing: run 'kernel-build' first\n" "{{KERNEL_SRC}}" >&2; exit 1; }
  mkdir -p "{{OUT}}/modules"
  rm -f "{{OUT}}/modules"/*.ko
  built=()
  for dir in /work/drivers/*/; do
    [[ -f "${dir}Makefile" ]] || continue
    {{MAKE}} -C "{{KERNEL_SRC}}" M="${dir%/}" modules
    for ko in "${dir}"*.ko; do
      cp "${ko}" "{{OUT}}/modules/"
      built+=("${ko##*/}")
    done
  done
  printf 'built %s/modules: %s\n' "{{OUT}}" "${built[*]:-(none)}" >&2

[doc("make clean in each /work/drivers/*/ module dir and remove OUT/modules/")]
modules-clean:
  #!/usr/bin/env bash
  set -euo pipefail
  if [[ -d "{{KERNEL_SRC}}" ]]; then
    for dir in /work/drivers/*/; do
      [[ -f "${dir}Makefile" ]] || continue
      {{MAKE}} -C "{{KERNEL_SRC}}" M="${dir%/}" clean
    done
  else
    printf '%s absent; skipping module clean\n' "{{KERNEL_SRC}}" >&2
  fi
  rm -rf "{{OUT}}/modules"

[doc("Build every program under /work/userspace/*/ as a static binary with clang; binaries go to OUT/userspace/")]
userspace:
  #!/usr/bin/env bash
  set -euo pipefail
  shopt -s nullglob
  rm -rf "{{OUT}}/userspace"
  mkdir -p "{{OUT}}/userspace"
  for dir in /work/userspace/*/; do
    [[ -f "${dir}Makefile" ]] || continue
    make -C "${dir%/}" CC=clang OUT="{{OUT}}/userspace"
  done
  built=("{{OUT}}/userspace"/*)
  built=("${built[@]##*/}")
  printf 'built %s/userspace: %s\n' "{{OUT}}" "${built[*]:-(none)}" >&2

[doc("make clean in each /work/userspace/*/ program dir and remove OUT/userspace/")]
userspace-clean:
  #!/usr/bin/env bash
  set -euo pipefail
  shopt -s nullglob
  for dir in /work/userspace/*/; do
    [[ -f "${dir}Makefile" ]] || continue
    make -C "${dir%/}" CC=clang OUT="{{OUT}}/userspace" clean
  done
  rm -rf "{{OUT}}/userspace"

[doc("Stage a busybox root with /work/vdev/initramfs/init, any OUT/modules/*.ko at /lib/modules and any OUT/userspace/* at /usr/bin, and pack it to OUT/initramfs.cpio.gz")]
initramfs:
  #!/usr/bin/env bash
  set -euo pipefail
  busybox="$(command -v busybox)"
  file -b "${busybox}" | grep -q 'statically linked' || { printf '%s is not statically linked\n' "${busybox}" >&2; exit 1; }
  root="$(mktemp -d)"
  trap 'rm -rf "${root}"' EXIT
  mkdir -p "${root}/bin" "${root}/sbin" "${root}/proc" "${root}/sys" "${root}/dev"
  cp "${busybox}" "${root}/bin/busybox"
  cp /work/vdev/initramfs/init "${root}/init"
  chmod 755 "${root}/init"
  # busybox links applets to its own resolved path; chroot makes that /bin/busybox, as the guest sees it.
  chroot "${root}" /bin/busybox --install -s /bin
  if [[ -d "{{OUT}}/modules" ]]; then
    mkdir -p "${root}/lib/modules"
    for ko in "{{OUT}}/modules"/*.ko; do
      [[ -f "${ko}" ]] && cp "${ko}" "${root}/lib/modules/"
    done
  else
    printf '%s/modules absent; building initramfs without modules\n' "{{OUT}}" >&2
  fi
  if [[ -d "{{OUT}}/userspace" ]]; then
    mkdir -p "${root}/usr/bin"
    for bin in "{{OUT}}/userspace"/*; do
      [[ -f "${bin}" ]] && install -m 755 "${bin}" "${root}/usr/bin/"
    done
  else
    printf '%s/userspace absent; building initramfs without userspace programs\n' "{{OUT}}" >&2
  fi
  cd "${root}"
  find . | cpio -o -H newc --quiet | gzip > "{{OUT}}/initramfs.cpio.gz"
  printf 'built %s/initramfs.cpio.gz (%s bytes)\n' "{{OUT}}" "$(stat -c %s "{{OUT}}/initramfs.cpio.gz")" >&2

# Style tools: kernel coding style on both sides of an exercise.

# Prints one *.c/*.h path per line under every ROOT/*/, or under ROOT/NAME/ for each ROOT
# where it exists when NAME is set. kbuild's generated *.mod.c is excluded.
[private]
sources NAME +ROOTS:
  #!/usr/bin/env bash
  set -euo pipefail
  shopt -s nullglob
  name="${1}"
  shift
  [[ "${name}" != */* ]] || { printf '%s: a directory name, not a path\n' "${name}" >&2; exit 1; }
  dirs=()
  for root in "$@"; do
    if [[ -z "${name}" ]]; then
      dirs+=("${root}"/*/)
    elif [[ -d "${root}/${name}" ]]; then
      dirs+=("${root}/${name}")
    fi
  done
  (( ${#dirs[@]} > 0 )) || { printf 'no directory %s under %s\n' "${name:-*/}" "$*" >&2; exit 1; }
  files="$(find "${dirs[@]}" -type f \( -name '*.c' -o -name '*.h' \) ! -name '*.mod.c' | sort)"
  [[ -n "${files}" ]] || { printf 'no *.c or *.h files under %s\n' "${dirs[*]}" >&2; exit 1; }
  printf '%s\n' "${files}"

[doc("Run the kernel tree's checkpatch.pl over every *.c and *.h under /work/drivers/*/ (or /work/drivers/NAME/); nonzero on any error or warning")]
checkpatch NAME="":
  #!/usr/bin/env bash
  set -euo pipefail
  [[ -f "{{KERNEL_SRC}}/scripts/checkpatch.pl" ]] || { printf "%s/scripts/checkpatch.pl missing: run 'kernel-fetch' first\n" "{{KERNEL_SRC}}" >&2; exit 1; }
  list="$(just --justfile "{{justfile()}}" sources "{{NAME}}" /work/drivers)"
  mapfile -t files <<< "${list}"
  "{{KERNEL_SRC}}/scripts/checkpatch.pl" --no-tree --terse -f "${files[@]}"

[doc("Rewrite IN PLACE every *.c and *.h under /work/drivers/*/ and /work/userspace/*/ (or the NAME dir in each) with clang-format and the kernel tree's .clang-format")]
format NAME="":
  #!/usr/bin/env bash
  set -euo pipefail
  [[ -f "{{KERNEL_SRC}}/.clang-format" ]] || { printf "%s/.clang-format missing: run 'kernel-fetch' first\n" "{{KERNEL_SRC}}" >&2; exit 1; }
  list="$(just --justfile "{{justfile()}}" sources "{{NAME}}" /work/drivers /work/userspace)"
  mapfile -t files <<< "${list}"
  clang-format -i --style="file:{{KERNEL_SRC}}/.clang-format" "${files[@]}"
  printf 'formatted %d files\n' "${#files[@]}" >&2
