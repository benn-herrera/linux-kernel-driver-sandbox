# Runs inside the build container, mounted read-only at /work/vdev.
# Every path here is a container path.

set positional-arguments

import '../active_exercise.just'

KERNEL_VERSION := "7.2.7"
KERNEL_SRC := "/kernel/linux-" + KERNEL_VERSION
OUT := "/work/out"
EXERCISE_DIR := "/work/exercises" / EXERCISE
# clang/LLVM for every kbuild invocation: the kernel's Rust support builds with LLVM.
MAKE := "make LLVM=1"

[doc("download, verify and extract the pinned kernel source into the volume (no-op if present)")]
kernel-fetch:
  #!/usr/bin/env bash
  set -euo pipefail
  if [[ -d "{{KERNEL_SRC}}" ]]; then
    printf '%s already present; nothing to fetch\n' "{{KERNEL_SRC}}" >&2
    exit 0
  fi
  cd /kernel
  version="{{KERNEL_VERSION}}"
  tarball="linux-${version}.tar.xz"
  url_dir="https://cdn.kernel.org/pub/linux/kernel/v${version%%.*}.x"
  printf 'downloading %s/%s\n' "${url_dir}" "${tarball}" >&2
  curl -fsSLO "${url_dir}/${tarball}"
  curl -fsSLO "${url_dir}/sha256sums.asc"
  grep -E "  ${tarball}$" sha256sums.asc | sha256sum -c -
  tar -xf "${tarball}"
  rm -f "${tarball}" sha256sums.asc
  printf 'extracted to %s\n' "{{KERNEL_SRC}}" >&2

[doc("configure the kernel: defconfig, the debug.config fragment, then /work/vdev/kernel-config/*.config merged on top")]
kernel-config: kernel-fetch
  #!/usr/bin/env bash
  set -euo pipefail
  cd "{{KERNEL_SRC}}"
  {{MAKE}} defconfig debug.config
  [[ -f .config ]] || { printf '.config missing after make\n' >&2; exit 1; }
  scripts/kconfig/merge_config.sh -m .config /work/vdev/kernel-config/*.config
  {{MAKE}} olddefconfig
  printf '%s/.config written\n' "{{KERNEL_SRC}}" >&2
  for opt in KASAN PROVE_LOCKING DEBUG_ATOMIC_SLEEP UBSAN RUST; do
    printf 'CONFIG_%s=%s\n' "${opt}" "$(scripts/config --state "${opt}")"
  done
  # Kconfig drops CONFIG_RUST=y silently when RUST_IS_AVAILABLE is false; this is the only reliable signal.
  [[ "$(scripts/config --state RUST)" == "y" ]] || { printf "CONFIG_RUST did not survive: run '%s rustavailable' in %s\n" "{{MAKE}}" "{{KERNEL_SRC}}" >&2; exit 1; }

[doc("build the kernel Image and in-tree modules, and copy the Image to OUT/Image")]
kernel-build: kernel-config
  #!/usr/bin/env bash
  set -euo pipefail
  cd "{{KERNEL_SRC}}"
  {{MAKE}} -j"$(nproc)" Image modules
  cp arch/arm64/boot/Image "{{OUT}}/Image"
  printf 'built %s/Image\n' "{{OUT}}" >&2

[doc("make clean in the kernel tree (keeps .config); no-op if the tree is absent")]
kernel-clean:
  #!/usr/bin/env bash
  set -euo pipefail
  if [[ ! -d "{{KERNEL_SRC}}" ]]; then
    printf '%s absent; nothing to clean\n' "{{KERNEL_SRC}}" >&2
    exit 0
  fi
  {{MAKE}} -C "{{KERNEL_SRC}}" clean

# Fails unless the active exercise exists; the dependency of every exercise-scoped recipe.
[private]
exercise-check:
  #!/usr/bin/env bash
  set -euo pipefail
  [[ -d "{{EXERCISE_DIR}}" ]] || { printf "exercise '%s' not found under /work/exercises\n" "{{EXERCISE}}" >&2; exit 1; }

[doc("build the active exercise's out-of-tree module, /work/exercises/EXERCISE/driver/, with M= against the kernel tree; .ko files go to OUT/driver/ (cleared first)")]
driver: exercise-check
  #!/usr/bin/env bash
  set -euo pipefail
  shopt -s nullglob
  [[ -f "{{KERNEL_SRC}}/Module.symvers" ]] || { printf "%s/Module.symvers missing: run 'kernel-build' first\n" "{{KERNEL_SRC}}" >&2; exit 1; }
  driver="{{EXERCISE_DIR}}/driver"
  [[ -f "${driver}/Makefile" ]] || { printf '%s/Makefile missing\n' "${driver}" >&2; exit 1; }
  mkdir -p "{{OUT}}/driver"
  rm -f "{{OUT}}/driver"/*.ko
  mo="{{OUT}}/driver-build/{{EXERCISE}}"
  mkdir -p "${mo}"
  {{MAKE}} -C "{{KERNEL_SRC}}" M="${driver}" MO="${mo}" modules
  built=()
  for ko in "${mo}"/*.ko; do
    cp "${ko}" "{{OUT}}/driver/"
    built+=("${ko##*/}")
  done
  printf 'built %s/driver: %s\n' "{{OUT}}" "${built[*]:-(none)}" >&2

[doc("remove OUT/driver-build/ (the MO= build trees) and OUT/driver/ for every exercise, not only the active one")]
driver-clean:
  #!/usr/bin/env bash
  set -euo pipefail
  rm -rf "{{OUT}}/driver-build" "{{OUT}}/driver"

[doc("generate the active exercise's userspace API artifacts: make -C /work/exercises/EXERCISE/userspace/api_def with exercises/gen.mk, which runs vdev/api_gen for the exercise's one *.adef.toml when it is newer than its outputs under OUT/userspace-build/EXERCISE/generated/; outputs land under generated/include/EXERCISE/ (the C header and the header-only C++ wrapper), generated/binding/ (the Lua module), generated/rust/ (the Rust binding and ABI relay, compile-time inputs a crate reaches through API_GEN_RUST_DIR, never staged) and generated/stub/ (the implementation stubs, never staged); no-op with a note when the exercise has no api_def/Makefile")]
generate: exercise-check
  #!/usr/bin/env bash
  set -euo pipefail
  dir="{{EXERCISE_DIR}}/userspace/api_def"
  if [[ ! -f "${dir}/Makefile" ]]; then
    printf 'no api_def/Makefile under %s; nothing to generate\n' "${dir}" >&2
    exit 0
  fi
  make -C "${dir}" OUT="{{OUT}}/userspace-build/{{EXERCISE}}" API_GEN=/work/vdev
  printf 'generated %s/userspace-build/%s/generated\n' "{{OUT}}" "{{EXERCISE}}" >&2

[doc("run the API generator's unit tests (vdev/api_gen/tests) with the image's python3")]
api-gen-test:
  #!/usr/bin/env bash
  set -euo pipefail
  PYTHONDONTWRITEBYTECODE=1 python3 -m unittest discover -s /work/vdev/api_gen/tests -t /work/vdev

[doc("build the active exercise's /work/exercises/EXERCISE/userspace/ after generate: lib/ (a Makefile or a Cargo.toml, never both), then app_cpp/ (Makefile), then app_rs/ if present (Cargo.toml); make builds use clang, cargo builds use --offline --locked (the repository is read-only, so a stale Cargo.lock must fail rather than be rewritten) with CARGO_HOME=OUT/cargo-home so nothing is written into the container layer; intermediates go to OUT/userspace-build/EXERCISE/, and each product is verified after its build (libEXERCISE.so by file name and a SONAME equal to it, app_cpp and app_rs executable) and copied to OUT/userspace/ (cleared first), together with app_lua/ (each top-level *.lua under its stem, so app_lua.lua ships as app_lua; subdirectories whole; any other top-level file is refused) and the generated include/ and binding/ subtrees, staged whole; lib/*.h are the implementation's own and are not staged; the cargo crates' environment is CONVENTIONS.md \"Exercise userspace\"")]
userspace: exercise-check generate
  #!/usr/bin/env bash
  set -euo pipefail
  dir="{{EXERCISE_DIR}}/userspace"
  build="{{OUT}}/userspace-build/{{EXERCISE}}"
  out="{{OUT}}/userspace"
  libso="${build}/lib{{EXERCISE}}.so"
  function die() {
    printf '%s\n' "${*}" >&2
    exit 1
  }
  # cargo_build <manifest> <target-dir> [VAR=value...]
  function cargo_build() {
    local manifest="${1}" target="${2}"
    shift 2
    env CARGO_HOME="{{OUT}}/cargo-home" CARGO_TARGET_DIR="${target}" "${@}" \
      cargo build --offline --locked --manifest-path "${manifest}"
  }
  function check_layout() {
    local lib_make="${dir}/lib/Makefile" lib_cargo="${dir}/lib/Cargo.toml"
    if [[ -f "${lib_make}" && -f "${lib_cargo}" ]]; then
      die "${dir}/lib holds both Makefile and Cargo.toml; keep one"
    fi
    [[ -f "${lib_make}" || -f "${lib_cargo}" ]] || die "${dir}/lib needs Makefile or Cargo.toml"
    [[ -f "${dir}/app_cpp/Makefile" ]] || die "${dir}/app_cpp needs Makefile"
    if [[ -d "${dir}/app_rs" && ! -f "${dir}/app_rs/Cargo.toml" ]]; then
      die "${dir}/app_rs needs Cargo.toml"
    fi
  }
  function build_lib() {
    if [[ -f "${dir}/lib/Cargo.toml" ]]; then
      local cargo_so="${build}/cargo/lib/debug/lib{{EXERCISE}}.so"
      cargo_build "${dir}/lib/Cargo.toml" "${build}/cargo/lib" API_GEN_RUST_DIR="${build}/generated/rust" DRIVER_INCLUDE=/work/exercises
      [[ -f "${cargo_so}" ]] || die "${dir}/lib/Cargo.toml did not produce ${cargo_so}"
      cp "${cargo_so}" "${libso}"
    else
      make -C "${dir}/lib" CC=clang CXX=clang++ OUT="${build}" DRIVER_INCLUDE=/work/exercises
      [[ -f "${libso}" ]] || die "${dir}/lib/Makefile did not produce ${libso}"
    fi
    local soname
    soname="$(readelf -d "${libso}" | sed -n 's/.*Library soname: \[\(.*\)\]/\1/p')"
    [[ "${soname}" == "${libso##*/}" ]] || die "${libso} has SONAME '${soname}', expected '${libso##*/}'"
    cp "${libso}" "${out}/"
  }
  function build_app_cpp() {
    make -C "${dir}/app_cpp" CC=clang CXX=clang++ OUT="${build}" DRIVER_INCLUDE=/work/exercises
    [[ -x "${build}/app_cpp" ]] || die "${dir}/app_cpp/Makefile did not produce ${build}/app_cpp"
    cp "${build}/app_cpp" "${out}/"
  }
  function build_app_rs() {
    [[ -d "${dir}/app_rs" ]] || return 0
    local bin="${build}/cargo/app_rs/debug/app_rs"
    cargo_build "${dir}/app_rs/Cargo.toml" "${build}/cargo/app_rs" API_GEN_RUST_DIR="${build}/generated/rust" API_LIB_DIR="${build}"
    [[ -x "${bin}" ]] || die "${dir}/app_rs/Cargo.toml did not produce ${bin}"
    cp "${bin}" "${out}/"
  }
  # no build step: a top-level *.lua ships under its stem (app_lua.lua -> /usr/bin/app_lua, a test);
  # the source keeps its extension for the editor's language services; subdirectories ship whole
  function stage_lua() {
    [[ -d "${dir}/app_lua" ]] || return 0
    shopt -s nullglob
    local entry
    for entry in "${dir}/app_lua"/*; do
      if [[ -d "${entry}" ]]; then
        cp -r "${entry}" "${out}/"
      elif [[ "${entry}" == *.lua ]]; then
        cp "${entry}" "${out}/$(basename "${entry%.lua}")"
      else
        die "${entry}: app_lua/ ships only top-level *.lua and subdirectories; any other file would run as a test"
      fi
    done
  }
  # include/ and binding/ mirror OUT/userspace/, so each is staged whole;
  # rust/ and stub/ are compile-time inputs and copy-once stubs, never staged
  function stage_generated() {
    local sub
    for sub in include binding; do
      if [[ -d "${build}/generated/${sub}" ]]; then
        mkdir -p "${out}/${sub}"
        cp -r "${build}/generated/${sub}/." "${out}/${sub}/"
      fi
    done
  }
  check_layout
  rm -rf "${out}"
  mkdir -p "${out}" "${build}"
  stage_lua
  build_lib
  build_app_cpp
  build_app_rs
  stage_generated
  printf 'built %s: %s\n' "${out}" "{{EXERCISE}}" >&2

[doc("remove OUT/userspace-build/ (the intermediate trees) and OUT/userspace/ for every exercise, not only the active one")]
userspace-clean:
  #!/usr/bin/env bash
  set -euo pipefail
  rm -rf "{{OUT}}/userspace-build" "{{OUT}}/userspace"

[doc("generate OUT/compile_commands.json for the active exercise: the module's entries from the kbuild .cmd files under OUT/driver-build/EXERCISE via the kernel tree's gen_compile_commands.py, plus the userspace entries from the clang -MJ fragments under OUT/userspace-build/EXERCISE; for clangd-vdev on the host")]
compile-commands: exercise-check
  #!/usr/bin/env bash
  set -euo pipefail
  mo="{{OUT}}/driver-build/{{EXERCISE}}"
  [[ -d "${mo}" ]] || { printf "%s missing: run 'driver' first\n" "${mo}" >&2; exit 1; }
  build="{{OUT}}/userspace-build/{{EXERCISE}}"
  shopt -s nullglob
  frags=("${build}"/obj/*/*.o.json)
  (( ${#frags[@]} > 0 )) || { printf "%s has no obj/*/*.o.json fragments: run 'userspace' first\n" "${build}" >&2; exit 1; }
  tmp="$(mktemp -d)"
  trap 'rm -rf "${tmp}"' EXIT
  python3 "{{KERNEL_SRC}}/scripts/clang-tools/gen_compile_commands.py" -d "${mo}" -o "${tmp}/kernel.json"
  n="$(python3 - "${tmp}/kernel.json" "${build}" "{{OUT}}/compile_commands.json" <<'EOF'
  import glob
  import json
  import sys

  kernel_json, build, out_path = sys.argv[1:4]
  with open(kernel_json) as f:
      entries = json.load(f)
  for frag in sorted(glob.glob(f"{build}/obj/*/*.o.json")):
      with open(frag) as f:
          text = f.read().rstrip()
      if text.endswith(','):
          text = text[:-1]
      entries.append(json.loads(text))
  with open(out_path, 'w') as f:
      json.dump(entries, f, indent=1)
  print(len(entries))
  EOF
  )"
  printf 'wrote %s/compile_commands.json: %s entries\n' "{{OUT}}" "${n}" >&2

[doc("stage a busybox root with /work/vdev/initramfs/init, /work/vdev/initramfs/lkds-test and this image's /usr/bin/luajit at /usr/bin, any OUT/driver/*.ko at /lib/modules, any OUT/userspace/* by what it is: a file starting with `#!` is a script and, like an ELF executable (per `file`), goes to /usr/bin and into the /etc/lkds/tests manifest (executables first, then scripts); ELF shared objects go to /lib; anything else fails; a subdirectory of OUT/userspace/ other than include/ is staged whole under /usr/bin/ and never enters the manifest; OUT/userspace/include/, skipped by that classification, is staged whole to /usr/include/, preserving its per-exercise subdirectory; plus the loader at its PT_INTERP path and every library ldd resolves for luajit and the ELF files copied from this image to /lib; then pack it to OUT/initramfs.cpio.gz")]
initramfs:
  #!/usr/bin/env bash
  set -euo pipefail
  function stage_root() {
    busybox="$(command -v busybox)"
    file -b "${busybox}" | grep -q 'statically linked' || { printf '%s is not statically linked\n' "${busybox}" >&2; exit 1; }
    [[ -x /usr/bin/luajit ]] || { printf "/usr/bin/luajit missing from the image: run 'image-vdev'\n" >&2; exit 1; }
    root="$(mktemp -d)"
    trap 'rm -rf "${root}"' EXIT
    mkdir -p "${root}/bin" "${root}/sbin" "${root}/proc" "${root}/sys" "${root}/dev"
    cp "${busybox}" "${root}/bin/busybox"
    cp /work/vdev/initramfs/init "${root}/init"
    chmod 755 "${root}/init"
    # busybox links applets to its own resolved path; chroot makes that /bin/busybox, as the guest sees it.
    chroot "${root}" /bin/busybox --install -s /bin
    mkdir -p "${root}/usr/bin" "${root}/lib"
    install -m 755 /work/vdev/initramfs/lkds-test "${root}/usr/bin/lkds-test"
    # the guest's script interpreter: an executable that is not a test, so never in the manifest
    install -m 755 /usr/bin/luajit "${root}/usr/bin/luajit"
    elfs=(/usr/bin/luajit)
  }
  function stage_driver() {
    if [[ -d "{{OUT}}/driver" ]]; then
      mkdir -p "${root}/lib/modules"
      for ko in "{{OUT}}/driver"/*.ko; do
        [[ -f "${ko}" ]] && cp "${ko}" "${root}/lib/modules/"
      done
    else
      printf '%s/driver absent; building initramfs without modules\n' "{{OUT}}" >&2
    fi
  }
  function stage_userspace() {
    if [[ -d "{{OUT}}/userspace" ]]; then
      # executables run before scripts: the program is the smoke test, the script the long suite
      execs=(); scripts=()
      for bin in "{{OUT}}/userspace"/*; do
        # headers are staged separately below; not a program, library or script
        [[ "$(basename "${bin}")" == include ]] && continue
        # a subdirectory is script support (Lua modules): staged whole under /usr/bin, never a test
        if [[ -d "${bin}" ]]; then
          cp -r "${bin}" "${root}/usr/bin/"
          continue
        fi
        [[ -f "${bin}" ]] || continue
        if [[ "$(head -c 2 "${bin}")" == '#!' ]]; then
          # a script names its interpreter in the shebang; it has no ldd closure of its own
          kind=script
        else
          case "$(file -b "${bin}")" in
            ELF*" executable,"*) kind=exec ;;
            ELF*" shared object,"*) kind=lib ;;
            *) printf '%s is neither a #! script, an ELF executable nor a shared object\n' "${bin}" >&2; exit 1 ;;
          esac
        fi
        case "${kind}" in
          exec) install -m 755 "${bin}" "${root}/usr/bin/"; execs+=("$(basename "${bin}")") ;;
          script) install -m 755 "${bin}" "${root}/usr/bin/"; scripts+=("$(basename "${bin}")") ;;
          lib) install -m 755 "${bin}" "${root}/lib/" ;;
        esac
        [[ "${kind}" == script ]] || elfs+=("${bin}")
      done
      mkdir -p "${root}/etc/lkds"
      printf '%s\n' "${execs[@]}" "${scripts[@]}" > "${root}/etc/lkds/tests"
      if [[ -d "{{OUT}}/userspace/include" ]]; then
        mkdir -p "${root}/usr/include"
        cp -r "{{OUT}}/userspace/include/." "${root}/usr/include/"
      fi
    else
      printf '%s/userspace absent; building initramfs without userspace programs\n' "{{OUT}}" >&2
    fi
  }
  function stage_closure() {
    # Runtime closure from the image that built them; LD_LIBRARY_PATH resolves the exercise's own libraries.
    for elf in "${elfs[@]}"; do
      deps="$(LD_LIBRARY_PATH="{{OUT}}/userspace" ldd "${elf}" 2>&1)" || {
        [[ "${deps}" == *"not a dynamic executable"* ]] && continue
        printf 'ldd %s failed: %s\n' "${elf}" "${deps}" >&2; exit 1
      }
      while IFS= read -r line; do
        read -r name arrow target _ <<< "${line}"
        if [[ "${arrow}" == "=>" ]]; then
          [[ "${target}" == /* ]] || { printf '%s: %s\n' "${elf}" "${line}" >&2; exit 1; }
          cp -L "${target}" "${root}/lib/"
        elif [[ "${name}" == /* ]]; then
          # the interpreter: the kernel opens it at exactly its PT_INTERP path
          [[ "${name}" == /lib/* || "${name}" == /lib64/* ]] || { printf '%s: %s is outside /lib\n' "${elf}" "${name}" >&2; exit 1; }
          mkdir -p "${root}$(dirname "${name}")"
          cp -L "${name}" "${root}${name}"
        elif [[ "${name}" != linux-vdso* ]]; then
          printf '%s: unrecognised ldd line: %s\n' "${elf}" "${line}" >&2; exit 1
        fi
      done <<< "${deps}"
    done
  }
  function pack() {
    cd "${root}"
    find . | cpio -o -H newc --quiet | gzip > "{{OUT}}/initramfs.cpio.gz"
    printf 'built %s/initramfs.cpio.gz (%s bytes)\n' "{{OUT}}" "$(stat -c %s "{{OUT}}/initramfs.cpio.gz")" >&2
  }
  stage_root
  stage_driver
  stage_userspace
  stage_closure
  pack

[doc("build the modules and userspace programs and pack the initramfs, in one container, and the compile_commands.json (userspace runs generate first)")]
stage: driver userspace compile-commands initramfs

[doc("copy the kernel tree's .clang-format to OUT/clang-format for the host-side format recipe")]
export-clang-format:
  #!/usr/bin/env bash
  set -euo pipefail
  [[ -f "{{KERNEL_SRC}}/.clang-format" ]] || { printf "%s/.clang-format missing: run 'kernel-fetch' first\n" "{{KERNEL_SRC}}" >&2; exit 1; }
  cp -v "{{KERNEL_SRC}}/.clang-format" "{{OUT}}/clang-format"

[doc("run the kernel tree's checkpatch.pl over every *.c and *.h under every exercise's /work/exercises/*/driver/; nonzero on any error or warning")]
checkpatch:
  #!/usr/bin/env bash
  set -euo pipefail
  [[ -f "{{KERNEL_SRC}}/scripts/checkpatch.pl" ]] || { printf "%s/scripts/checkpatch.pl missing: run 'kernel-fetch' first\n" "{{KERNEL_SRC}}" >&2; exit 1; }
  find /work/exercises/*/driver -type f \( -name '*.c' -o -name '*.h' \) -print0 \
    | xargs -0 "{{KERNEL_SRC}}/scripts/checkpatch.pl" --no-tree --terse -f
  printf 'checkpatch: clean\n' >&2
